# Set these in PowerShell before running migrate_mysql_to_supabase.py.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=office_snacks
SUPABASE_DATABASE_URL=postgresql://your_user:your_password@your_supabase_host:5432/postgres?sslmode=require
