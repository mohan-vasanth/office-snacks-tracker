# Copy these values from your Supabase project's Connect dialog. Use Direct or Session pooler.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-from-supabase>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<username-from-supabase>
SPRING_DATASOURCE_PASSWORD=replace-me
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-me-with-a-long-secret
APP_EMPLOYEE_USERNAME=employee
APP_EMPLOYEE_PASSWORD=replace-me-with-a-long-secret
APP_EMPLOYEE_ID=1
